# TechiNews Backend environment variables
# Copy to .env and fill real values. .env is gitignored.

# App
APP_NAME=TechiNews
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Databases (optional during local dev — pipeline runs in-memory if absent)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=techinews
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Active pipeline ===
# Gemini — required (primary summarizer)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NewsAPI.org — required (article discovery)
NEWSAPI_KEY=

# Jina Reader — required (primary content extraction)
JINA_API_KEY=

# Firecrawl — required (extraction fallback)
FIRECRAWL_API_KEY=

# === Future / optional ===
APIFY_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=techinews/0.1
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=
FIREBASE_CREDENTIALS_PATH=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
