# TechiNews Flutter environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API base URL
API_BASE_URL=http://10.0.2.2:8000

# Feature flags
USE_MOCK_DATA=true

# Analytics (optional during dev)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Sentry (optional during dev)
SENTRY_DSN=
